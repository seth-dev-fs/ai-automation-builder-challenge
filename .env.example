# Copia para .env e preenche com as chaves que te enviámos.
# NUNCA faças commit do .env real.

# ── PostHog ────────────────────────────────────────────────────────────────
# Project API Key (escrita — para a LP capturar eventos). Começa por phc_
POSTHOG_PROJECT_KEY=

# Personal API Key (leitura — para os agentes fazerem queries). Começa por phx_
POSTHOG_PERSONAL_API_KEY=

# Host e ID do projeto
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_ID=

# ── LLM ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Geração de imagem (opcional) ───────────────────────────────────────────
# GOOGLE_API_KEY=
